# Copy to .env and fill in real values. Never commit .env.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=True

# Comma-separated list, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# IANA timezone name, e.g. America/New_York. See docs/settings.md for the
# settings.py wiring this expects.
TIME_ZONE=UTC

# --- Production (Gunicorn + Nginx) settings below ---
# Leave these unset for local `runserver` development; see
# docs/deployment_dry_run.md (local dry run) and docs/deployment_lightsail.md
# (production) for how to set them at each deployment stage.

# Real https:// origin(s) once behind Nginx, comma-separated,
# e.g. https://__APP_NAME__.example.com — required for POST requests
# (forms, login) to pass Django's CSRF check on the real domain.
CSRF_TRUSTED_ORIGINS=

# These default to `not DEBUG` (i.e. on whenever DEBUG=False) and only need
# to be set explicitly to override that — e.g. temporarily to False while
# testing the Gunicorn/Nginx stack locally over plain HTTP before a TLS
# cert exists.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Session timeout in seconds. Defaults to 1209600 (2 weeks) if unset.
# SESSION_COOKIE_AGE=1209600

# --- Backups (deploy/backup.sh) ---
# See deploy/backup.sh's header comment for the full setup and IAM scoping.

# GPG key ID/email to encrypt backups to. Required for backup.sh to run.
# BACKUP_GPG_RECIPIENT=

# If set, encrypted backups are also pushed to this S3 bucket.
# BACKUP_S3_BUCKET=

# BACKUP_LOCAL_DIR=/opt/__APP_NAME__/backups
# BACKUP_RETENTION_DAYS=7
